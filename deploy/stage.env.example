# stage environment — copy to /opt/url-shortener/deploy/stage.env on the
# stage droplet and fill in the secrets. Never commit the filled-in file.
IMAGE_REPO=ghcr.io/OWNER/url-shortener
IMAGE_TAG=stage
BASE_URL=http://STAGE_DROPLET_IP
GATEWAY_PORT=80
POSTGRES_USER=shortener
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=shortener
LOG_LEVEL=INFO
