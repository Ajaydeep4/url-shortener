# prod environment — copy to /opt/url-shortener/deploy/prod.env on the prod
# droplet and fill in the secrets. Never commit the filled-in file.
#
# IMAGE_TAG is pinned to an exact release version in prod (never a moving
# branch tag) so what runs is always a known, changelogged build. The deploy
# workflow overrides this value per release; rollback = set the previous
# version and `docker compose up -d`.
IMAGE_REPO=ghcr.io/OWNER/url-shortener
IMAGE_TAG=v1.1.0
BASE_URL=http://PROD_DROPLET_IP
GATEWAY_PORT=80
POSTGRES_USER=shortener
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=shortener
LOG_LEVEL=INFO
