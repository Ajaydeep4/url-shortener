# dev environment — copy to /opt/url-shortener/deploy/dev.env on the dev
# droplet and fill in the secrets. Never commit the filled-in file.
IMAGE_REPO=ghcr.io/OWNER/url-shortener
IMAGE_TAG=dev
BASE_URL=http://DEV_DROPLET_IP
GATEWAY_PORT=80
POSTGRES_USER=shortener
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=shortener
LOG_LEVEL=DEBUG
